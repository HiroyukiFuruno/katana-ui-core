#!/usr/bin/env bash
set -euo pipefail

push_updates="$(cat)"
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [[ "${KUC_PUSH_CONFIRMED:-}" != "1" ]]; then
  cat >&2 <<'MESSAGE'
KUC pre-push guard: push confirmation required.

Local implementation, tests, lint, OpenSpec updates, and commits are fix-and-continue work.
Only external transmission must stop for explicit confirmation.

Set KUC_PUSH_CONFIRMED=1 after confirmation to push.
MESSAGE
  exit 1
fi

echo "KUC pre-push guard: confirmation present; running release boundary guard."
just kuc-guardrails
printf '%s\n' "$push_updates" | bash scripts/hooks/kuc-hook-dispatcher.sh pre-push
