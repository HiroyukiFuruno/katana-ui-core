{
  "source_roots": ["crates"],
  "rules": {
    "file-length": {
      "enabled": true,
      "threshold": 300
    },
    "function-length": {
      "enabled": true,
      "threshold": 50
    },
    "nesting-depth": {
      "enabled": true,
      "threshold": 4
    },
    "pub-free-fn": {
      "enabled": true
    },
    "type-separation": {
      "enabled": true
    },
    "no-test-only-runtime-api": {
      "enabled": true
    },
    "interactive-component-requires-callback": {
      "enabled": true
    },
    "no-storybook-box-leak": {
      "enabled": true,
      "inputs": ["storybook"]
    },
    "no-helper-only-view-file": {
      "enabled": true
    },
    "openspec-done-requires-evidence": {
      "enabled": true,
      "inputs": ["openspec/changes"]
    },
    "file-length-design-review": {
      "enabled": true,
      "inputs": ["openspec/changes"]
    }
  }
}
